        {
          "command": "idle.sidebar.activate",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "idle.sidebar.activate",
          "when": "view =~ /^idle\\./ && viewItem == idle.item",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p .",
    "test": "python3 scripts/release_dependencies.py run -- npm run test:resolved",
    "test:resolved": "node scripts/prepare-host-tests.mjs && npm run compile && node --test test/*.test.cjs",
    "test:tunnels:live": "npm run compile && node scripts/smoke-dev-tunnels.cjs",
    "test:compute:live": "npm run compile && node scripts/smoke-compute.cjs",
    "test:webview": "node scripts/smoke-webview.mjs idle.vsix",
    "test:assembly": "node scripts/smoke-assembly.mjs idle.vsix",
    "build:host": "node scripts/build-host.mjs",
    "build:wasm": "python3 scripts/release_dependencies.py run -- node scripts/build-wasm.mjs",
    "build": "python3 scripts/release_dependencies.py run -- npm run build:resolved",
    "build:resolved": "npm run compile && npm run build:host && npm run build:wasm && npm run build:native",
    "check": "bash scripts/check.sh",
    "package": "vsce package --no-dependencies --out idle.vsix",
    "test:vscode": "node scripts/smoke-vscode.cjs idle.vsix",
    "test:vscode:sidebar": "node scripts/smoke-vscode-sidebar.cjs idle.vsix",
    "build:native": "python3 scripts/release_dependencies.py run -- node scripts/build-native.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.12.0",
    "typescript": "6.0.2"
  }
}
