{
  "name": "idle",
  "displayName": "Idle",
  "description": "Idle workspace host with shared Rust application and rendering libraries",
  "version": "0.1.0",
  "publisher": "idleai",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/idleai/vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.12"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Views and diagnostics are available. Native processes, credentials and transports require trust.",
      "restrictedConfigurations": [
        "idle.native.servicePath",
        "idle.native.peerPath",
        "idle.chainDirectory",
        "idle.native.capturePath",
        "idle.tracking.jsonl.directory"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Native adapters run on the host that owns the workspace files."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "idle.open",
        "title": "Idle: Open Workspace"
      },
      {
        "command": "idle.openDetail",
        "title": "Idle: Open Detail View"
      },
      {
        "command": "idle.showOutput",
        "title": "Idle: Show Output"
      },
      {
        "command": "idle.openSettings",
        "title": "Idle: Open Extension Settings"
      },
      {
        "command": "idle.restartNative",
        "title": "Idle: Restart Native Adapters",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.signIn",
        "title": "Idle: Sign In to GitHub",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.presence.showPeers",
        "title": "Idle: Show File Peers"
      },
      {
        "command": "idle.cleanupTunnels",
        "title": "Idle: Clean Up Dev Tunnels",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.tracking.start",
        "title": "Idle: Start Editor Capture",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.tracking.stop",
        "title": "Idle: Pause Editor Capture",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.tracking.status",
        "title": "Idle: Show Capture Status",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.history.openRecord",
        "title": "Idle: Open Raw Record",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.history.openOriginal",
        "title": "Idle: Open Original",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.history.openFile",
        "title": "Idle: Open Recorded File",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.history.openDiff",
        "title": "Idle: Open Recorded Diff",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "idle.history.openWorkingFile",
        "title": "Idle: Open Working File",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "configuration": {
      "title": "Idle",
      "properties": {
        "idle.native.servicePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute editchain-vscode-service path on the workspace host. Empty resolves a packaged binary for that host's platform and architecture."
        },
        "idle.native.peerPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute editchain-peer path on the workspace host. Empty resolves a packaged binary for that host's platform and architecture."
        },
        "idle.chainDirectory": {
          "type": "string",
          "default": ".editchain",
          "scope": "resource",
          "description": "Folder-local chain binding. Relative paths resolve against the explicitly selected workspace folder on the file-owning host."
        },
        "idle.native.capturePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute idle-editor-service path on the workspace host. Empty uses the packaged capture service."
        },
        "idle.tracking.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Record buffer revisions, unsaved edits, input indicators, Git context and reading indicators into the folder chain. Requires Workspace Trust."
        },
        "idle.tracking.readDwellMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 30000,
          "scope": "resource",
          "description": "Continuous foreground visibility required for a reading indicator, in milliseconds."
        },
        "idle.tracking.maxFileBytes": {
          "type": "number",
          "default": 8388608,
          "minimum": 1024,
          "maximum": 8388608,
          "scope": "resource",
          "description": "Maximum UTF-8 buffer size to capture. Skipped buffers produce an explicit capture gap."
        },
        "idle.tracking.jsonl.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Retain complete raw capture events in a portable JSONL archive in addition to the chain."
        },
        "idle.tracking.jsonl.directory": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Raw archive directory on the workspace host. Empty uses extension global storage; relative paths require one unambiguous folder."
        },
        "idle.native.historyPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute idle-history-service path on the workspace host. Empty uses the packaged history service."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "idle.workspace",
          "name": "Idle"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "idle.history.openRecord",
          "when": "false"
        },
        {
          "command": "idle.history.openOriginal",
          "when": "false"
        },
        {
          "command": "idle.history.openFile",
          "when": "false"
        },
        {
          "command": "idle.history.openDiff",
          "when": "false"
        },
        {
          "command": "idle.history.openWorkingFile",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:tunnels:live": "npm run compile && node scripts/smoke-dev-tunnels.cjs",
    "test:webview": "node scripts/smoke-webview.mjs idle.vsix",
    "build:host": "node scripts/build-host.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run compile && npm run build:host && npm run build:wasm && npm run build:capture && npm run build:history",
    "check": "bash scripts/check.sh",
    "package": "vsce package --no-dependencies --out idle.vsix",
    "build:capture": "node scripts/build-capture.mjs",
    "build:history": "node scripts/build-history.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.12.0",
    "typescript": "6.0.2"
  },
  "overrides": {
    "@microsoft/dev-tunnels-connections": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@microsoft/dev-tunnels-connections": "1.3.56",
    "@microsoft/dev-tunnels-contracts": "1.3.56",
    "@microsoft/dev-tunnels-management": "1.3.56",
    "@microsoft/dev-tunnels-ssh": "3.12.42",
    "@microsoft/dev-tunnels-ssh-tcp": "3.12.42",
    "node-rsa": "2.0.0",
    "vscode-jsonrpc": "4.0.0"
  }
}
