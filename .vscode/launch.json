{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Idle Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "build"
    },
    {
      "name": "Rust: vGDB (interactive) \u2014 editchain-node/editchain",
      "type": "vgdb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/editchain-legacy",
      "cwd": "${workspaceFolder}",
      "debugger": "gdb",
      "args": [
        "import",
        "--workspace",
        "/mnt/hot/ambientlight/repos/editchain",
        "--chain",
        "./outputs/cc-chain"
      ],
      "env": {
        "RUST_BACKTRACE": "1"
      },
      "preLaunchTask": "cargo build (debug): editchain-node/editchain",
      "externalConsole": false,
      "stopOnEntry": false,
      "useAbsoluteFilePaths": true,
      "debug": "basic",
      "startupCmds": [
        "set breakpoint pending on",
        "set pagination off",
        "set print pretty on"
      ]
    }
  ]
}
